{
  "compilerOptions": {
    "target": "es2023",
    "outDir": "dist/ts",
    "jsx": "react-jsx",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "bun",
      "vite/client"
    ]
  },
  "include": [
    "stories/**/*",
    "packages/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
